# =============================================================================
# Spring AI Demo - Local Development Configuration
# =============================================================================
# Copy this file to application-local.properties and fill in your values
# IMPORTANT: Do NOT commit application-local.properties to version control!
# It is already ignored by .gitignore
# =============================================================================

# Gemini API Configuration
# Get your API key from: https://aistudio.google.com/app/apikey
gemini.api.key=YOUR_GEMINI_API_KEY_HERE

# Optional: Override server port for local development
# server.port=8080

# Optional: Enable debug logging for local development
# logging.level.com.Ai.SpringAIDemo=DEBUG
